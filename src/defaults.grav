// defaults.grav — the configuration an app has without config files: each
// setting from the environment (.env) when set, else a sensible default.
// config/*.json overrides any of them.
import "std"
import "apogee-config"
import "application.grav"

namespace apogee {

    class Defaults {
        static fn apply(app: Application) {
            let base = app.basePath;
            let put = fn(path: string, value: any) { if (!Config.has(path)) { Config.set(path, value); } };
            let p = fn(sub: string) -> string { return Path.combine(base, sub); };
            // app
            put("app.name", Env.get("APP_NAME", "Apogee"));
            put("app.env", Env.get("APP_ENV", "production"));
            put("app.debug", Env.getBool("APP_DEBUG", false));
            put("app.url", Env.get("APP_URL", "http://localhost:8000"));
            put("app.key", Env.get("APP_KEY", ""));
            put("app.timezone", Env.get("APP_TIMEZONE", "UTC"));
            put("app.locale", Env.get("APP_LOCALE", "en"));
            put("app.maintenance.file", p("storage/framework/down"));
            // http
            put("http.host", Env.get("HTTP_HOST", "*"));
            put("http.port", Env.getInt("HTTP_PORT", 8000));
            put("http.trusted_proxies", Env.get("TRUSTED_PROXIES", ""));
            // logging
            put("logging.default", Env.get("LOG_CHANNEL", "stack"));
            put("logging.level", Env.get("LOG_LEVEL", "debug"));
            put("logging.channels.stack.driver", "stack");
            put("logging.channels.stack.channels", Env.get("LOG_STACK", "single"));
            put("logging.channels.single.driver", "single");
            put("logging.channels.single.path", p("storage/logs/app.log"));
            put("logging.channels.daily.driver", "daily");
            put("logging.channels.daily.path", p("storage/logs/app.log"));
            put("logging.channels.daily.days", Env.getInt("LOG_DAILY_DAYS", 14));
            put("logging.channels.stderr.driver", "stderr");
            // database
            put("database.default", Env.get("DB_CONNECTION", "sqlite"));
            put("database.connections.sqlite.driver", "sqlite");
            put("database.connections.sqlite.database", Env.get("DB_DATABASE", p("database/database.sqlite")));
            put("database.connections.mysql.driver", "mysql");
            put("database.connections.mysql.url", Env.get("DB_URL", "mysql://root@127.0.0.1:3306/apogee"));
            put("database.connections.pgsql.driver", "postgres");
            put("database.connections.pgsql.url", Env.get("DB_URL", "postgresql://postgres@127.0.0.1:5432/apogee"));
            put("database.pool", Env.getInt("DB_POOL", 8));
            // redis
            put("redis.url", Env.get("REDIS_URL", ""));
            // cache
            put("cache.default", Env.get("CACHE_STORE", "memory"));
            put("cache.prefix", Env.get("CACHE_PREFIX", "apogee:cache:"));
            put("cache.stores.file.path", p("storage/framework/cache"));
            // queue
            put("queue.default", Env.get("QUEUE_CONNECTION", "sync"));
            put("queue.retry_after", Env.getInt("QUEUE_RETRY_AFTER", 90));
            put("queue.failed.driver", Env.get("QUEUE_FAILED_DRIVER", "file"));
            put("queue.failed.path", p("storage/logs/failed-jobs.jsonl"));
            // session
            put("session.driver", Env.get("SESSION_DRIVER", "file"));
            put("session.lifetime", Env.getInt("SESSION_LIFETIME", 120));
            put("session.path", p("storage/framework/sessions"));
            put("session.cookie", Env.get("SESSION_COOKIE", "apogee_session"));
            // views
            put("view.paths", p("resources/views"));
            // mail
            put("mail.default", Env.get("MAIL_MAILER", "log"));
            put("mail.from.address", Env.get("MAIL_FROM_ADDRESS", "hello@example.com"));
            put("mail.from.name", Env.get("MAIL_FROM_NAME", Env.get("APP_NAME", "Apogee")));
            put("mail.smtp.url", Env.get("MAIL_URL", "smtp://127.0.0.1:1025?security=none"));
            put("mail.log.path", p("storage/logs/mail.log"));
            put("mail.always_to", Env.get("MAIL_ALWAYS_TO", ""));
            // auth
            put("auth.model", Env.get("AUTH_MODEL", ""));
            put("auth.home", Env.get("AUTH_HOME", "/home"));
            put("auth.login", Env.get("AUTH_LOGIN", "/login"));
            put("auth.password_iterations", Env.getInt("AUTH_PASSWORD_ITERATIONS", 600000));
            // encryption: older keys still read (comma-separated)
            put("app.previous_keys", Env.get("APP_PREVIOUS_KEYS", ""));
            put("app.fallback_locale", Env.get("APP_FALLBACK_LOCALE", "en"));
            // storage
            put("filesystems.default", Env.get("FILESYSTEM_DISK", "local"));
            put("filesystems.disks.local.root", p("storage/app"));
            put("filesystems.disks.public.root", p("storage/app/public"));
            put("filesystems.disks.public.url", Env.get("APP_URL", "http://localhost:8000") + "/storage");
            put("filesystems.disks.s3.bucket", Env.get("AWS_BUCKET", ""));
            put("filesystems.disks.s3.region", Env.get("AWS_DEFAULT_REGION", "us-east-1"));
            put("filesystems.disks.s3.key", Env.get("AWS_ACCESS_KEY_ID", ""));
            put("filesystems.disks.s3.secret", Env.get("AWS_SECRET_ACCESS_KEY", ""));
            put("filesystems.disks.s3.endpoint", Env.get("AWS_ENDPOINT", ""));
            put("filesystems.disks.s3.path_style", Env.getBool("AWS_USE_PATH_STYLE_ENDPOINT", true));
            // translations
            put("lang.path", p("lang"));
            // broadcasting, and the sockets server (sockets:serve)
            put("broadcasting.default", Env.get("BROADCAST_CONNECTION", "null"));
            put("broadcasting.connections.sockets.url", Env.get("SOCKETS_URL", "http://127.0.0.1:6001"));
            put("broadcasting.connections.sockets.app_id", Env.get("SOCKETS_APP_ID", "apogee"));
            put("broadcasting.connections.sockets.key", Env.get("SOCKETS_APP_KEY", "apogee-key"));
            put("broadcasting.connections.sockets.secret", Env.get("SOCKETS_APP_SECRET", ""));
            put("sockets.host", Env.get("SOCKETS_HOST", "0.0.0.0"));
            put("sockets.port", Env.getInt("SOCKETS_PORT", 6001));
            // feature flags, search
            put("features.store", Env.get("FEATURES_STORE", "database"));
            put("scout.driver", Env.get("SCOUT_DRIVER", "database"));
            put("scout.prefix", Env.get("SCOUT_PREFIX", ""));
            put("scout.meilisearch.host", Env.get("MEILISEARCH_HOST", "http://127.0.0.1:7700"));
            put("scout.meilisearch.key", Env.get("MEILISEARCH_KEY", ""));
            // dashboards: Telescope (local by default), Pulse and the queue's (opt in)
            put("telescope.enabled", Env.getBool("TELESCOPE_ENABLED", Env.get("APP_ENV", "production") == "local"));
            put("telescope.driver", Env.get("TELESCOPE_DRIVER", "database"));
            put("telescope.path", Env.get("TELESCOPE_PATH", "telescope"));
            put("telescope.slow_query_ms", Env.getInt("TELESCOPE_SLOW_QUERY_MS", 100));
            put("telescope.ignore_paths", Env.get("TELESCOPE_IGNORE_PATHS", ""));
            put("pulse.enabled", Env.getBool("PULSE_ENABLED", false));
            put("pulse.driver", Env.get("PULSE_DRIVER", "database"));
            put("pulse.path", Env.get("PULSE_PATH", "pulse"));
            put("pulse.server", Env.get("PULSE_SERVER_NAME", ""));
            put("pulse.sample_rate", Env.get("PULSE_SAMPLE_RATE", "1"));
            put("pulse.keep_hours", Env.getInt("PULSE_KEEP_HOURS", 168));
            put("pulse.slow_request_ms", Env.getInt("PULSE_SLOW_REQUEST_MS", 1000));
            put("pulse.slow_query_ms", Env.getInt("PULSE_SLOW_QUERY_MS", 1000));
            put("pulse.slow_job_ms", Env.getInt("PULSE_SLOW_JOB_MS", 1000));
            put("pulse.ignore_paths", Env.get("PULSE_IGNORE_PATHS", ""));
            put("queue_dashboard.enabled", Env.getBool("QUEUE_DASHBOARD_ENABLED", false));
            put("queue_dashboard.driver", Env.get("QUEUE_DASHBOARD_DRIVER", "database"));
            put("queue_dashboard.path", Env.get("QUEUE_DASHBOARD_PATH", "queue-dashboard"));
            // social sign-in: each provider with a client id (GITHUB_CLIENT_ID…)
            let url = Env.get("APP_URL", "http://localhost:8000");
            for (name in ["github", "google", "microsoft", "gitlab", "bitbucket", "discord", "facebook", "linkedin", "slack", "oidc"]) {
                let up = Str.upper(name);
                put("services." + name + ".client_id", Env.get(up + "_CLIENT_ID", ""));
                put("services." + name + ".client_secret", Env.get(up + "_CLIENT_SECRET", ""));
                put("services." + name + ".redirect", Env.get(up + "_REDIRECT_URI", url + "/auth/" + name + "/callback"));
            }
            put("services.microsoft.tenant", Env.get("MICROSOFT_TENANT", "common"));
            put("services.gitlab.host", Env.get("GITLAB_HOST", "https://gitlab.com"));
            put("services.oidc.issuer", Env.get("OIDC_ISSUER", ""));
        }
    }
}
