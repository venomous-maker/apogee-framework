// commands.grav — the framework's commands: about, env, key:generate,
// config:show, route:list, serve, down/up, migrate (and :status, :rollback,
// :reset, :refresh, :fresh), db:seed, queue:work/failed/retry/forget/flush/
// restart/clear/monitor, cache:clear, view:clear, mail:test, inspire.
import "std"
import "apogee-support"
import "apogee-config"
import "apogee-routing"
import "apogee-console"
import "apogee-queue"
import "apogee-view"
import "apogee-mail"
import "grav-cache"
import "grav-orbit"
import "maintenance.grav"
import "application.grav"

namespace apogee {

    class FrameworkCommands {
        static fn register(k: ConsoleKernel) {
            k.add::<AboutCommand>(); k.add::<EnvCommand>(); k.add::<KeyGenerateCommand>(); k.add::<ConfigShowCommand>();
            k.add::<RouteListCommand>(); k.add::<ServeCommand>(); k.add::<DownCommand>(); k.add::<UpCommand>();
            k.add::<MigrateCommand>(); k.add::<MigrateStatusCommand>(); k.add::<MigrateRollbackCommand>(); k.add::<MigrateResetCommand>();
            k.add::<MigrateRefreshCommand>(); k.add::<MigrateFreshCommand>(); k.add::<DbSeedCommand>();
            k.add::<QueueWorkCommand>(); k.add::<QueueFailedCommand>(); k.add::<QueueRetryCommand>(); k.add::<QueueForgetCommand>();
            k.add::<QueueFlushCommand>(); k.add::<QueueRestartCommand>(); k.add::<QueueClearCommand>(); k.add::<QueueMonitorCommand>();
            k.add::<CacheClearCommand>(); k.add::<ViewClearCommand>(); k.add::<MailTestCommand>(); k.add::<InspireCommand>();
        }
        // Asks before something destructive in production (unless --force).
        static fn confirmInProduction(c: ConsoleCommand, app: Application) -> bool {
            if (!app.isProduction() || c.flag("force")) { return true; }
            c.output.warnBlock("The app is in production.");
            return c.confirm("Are you sure you want to run this command?", false);
        }
    }

    class AboutCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "about {--json : As JSON}"; }
        fn description() -> string { return "Show basic information about the app"; }
        fn handle(app: Application) -> int {
            let sections: Array<Array<string>> = [
                ["Environment", "Application Name", app.name], ["Environment", "Apogee Version", app.version],
                ["Environment", "Environment", app.environment], ["Environment", "Debug Mode", app.debug ? "ENABLED" : "OFF"],
                ["Environment", "URL", app.url], ["Environment", "Timezone", app.timezone], ["Environment", "Maintenance Mode", app.isDownForMaintenance() ? "ON" : "OFF"],
                ["Drivers", "Cache", Config.getString("cache.default")], ["Drivers", "Database", Config.getString("database.default")],
                ["Drivers", "Logs", Config.getString("logging.default")], ["Drivers", "Mail", Config.getString("mail.default")],
                ["Drivers", "Queue", Config.getString("queue.default")], ["Drivers", "Session", Config.getString("session.driver")],
                ["App", "Providers", "${app.providerList().size()}"], ["App", "Routes", "${app.router().all().size()}"],
                ["App", "Commands", "${app.console().all().size()}"], ["App", "Scheduled tasks", "${app.schedule().tasks().size()}"]];
            if (self.flag("json")) {
                let o = Json.object();
                for (row in sections) {
                    let key = Text.snake(row[0]);
                    if (!o.has(key)) { o.set(key, Json.object()); }
                    o.get(key).set(Text.snake(row[1]), row[2]);
                }
                self.output.writeln(o.pretty());
                return 0;
            }
            let group = "";
            for (row in sections) {
                if (row[0] != group) { self.newLine(); self.output.twoColumn("<fg=green;options=bold>" + row[0] + "</>"); group = row[0]; }
                self.output.twoColumn(row[1], row[2]);
            }
            self.newLine();
            return 0;
        }
    }

    class EnvCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "env"; }
        fn description() -> string { return "Show the current environment"; }
        fn handle(app: Application) -> int { self.output.infoBlock("The application environment is [" + app.environment + "]."); return 0; }
    }

    class KeyGenerateCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "key:generate {--show : Print the key instead of saving it} {--force : Replace a key that is set}"; }
        fn description() -> string { return "Set the app key (APP_KEY in .env)"; }
        fn handle(app: Application) -> int {
            let key = "base64:" + Base64.encodeBytes(Bytes.fromHex(Hash.randomToken(32)));
            if (self.flag("show")) { self.output.writeln("<comment>" + key + "</>"); return 0; }
            let path = app.path(".env");
            let f = new File(path);
            let text = f.exists() ? f.read() : "";
            if (Str.contains(text, "APP_KEY=") && !Str.contains(text, "APP_KEY=\n") && !Str.endsWith(text, "APP_KEY=") && !self.flag("force")) {
                if (!self.confirm("APP_KEY is already set. Replace it?", false)) { return 1; }
            }
            let lines = new Array<string>();
            let done = false;
            for (l in Str.lines(text)) {
                if (Str.startsWith(l, "APP_KEY=")) { lines.push("APP_KEY=" + key); done = true; } else { lines.push(l); }
            }
            if (!done) { lines.push("APP_KEY=" + key); }
            f.write(Str.join(lines, "\n") + "\n");
            Config.set("app.key", key);
            app.key = key;
            self.output.infoBlock("Application key set successfully.");
            return 0;
        }
    }

    class ConfigShowCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "config:show {key? : A config path (all of it when left out)}"; }
        fn description() -> string { return "Show configuration values"; }
        fn handle() -> int {
            let key = self.argument("key");
            let v = key == "" ? Config.all() as any : Config.get(key);
            if (v == null) { self.error("No configuration called '" + key + "'."); return 1; }
            if (v is HashMap<string, any>) {
                let flat = Arr.dot(v as HashMap<string, any>);
                let names = flat.keys();
                Sort.sort(names);
                for (n in names) {
                    let shown = Str.contains(Str.lower(n), "key") || Str.contains(Str.lower(n), "password") || Str.contains(Str.lower(n), "secret") ? "********" : str(flat[n]);
                    self.output.twoColumn((key == "" ? "" : key + ".") + n, shown);
                }
                return 0;
            }
            self.output.twoColumn(key, str(v));
            return 0;
        }
    }

    class RouteListCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "route:list {--method= : Only this method} {--name= : Names containing this} {--path= : Paths containing this} {--json}"; }
        fn description() -> string { return "List the routes"; }
        fn handle(router: Router) -> int {
            let rows = new Array<RouteDef>();
            for (r in router.all()) {
                if (self.option("method") != "" && !r.methods.contains(Str.upper(self.option("method")))) { continue; }
                if (self.option("name") != "" && !Str.contains(r.routeName, self.option("name"))) { continue; }
                if (self.option("path") != "" && !Str.contains(r.uri, self.option("path"))) { continue; }
                rows.push(r);
            }
            if (self.flag("json")) {
                let a = Json.array();
                for (r in rows) {
                    let o = Json.object();
                    o.set("method", Str.join(r.methods, "|")); o.set("uri", r.uri); o.set("name", r.routeName); o.set("action", r.action);
                    o.set("middleware", Json.strings(r.middlewareNames));
                    a.push(o);
                }
                self.output.writeln(a.pretty());
                return 0;
            }
            for (r in rows) {
                let methods = Str.join(r.methods, "|");
                let color = Str.contains(methods, "GET") ? "blue" : (Str.contains(methods, "DELETE") ? "red" : "yellow");
                let left = "<fg=" + color + ">" + Text.padRight(methods, 10) + "</> " + r.uri;
                let right = (r.routeName == "" ? "" : r.routeName + " › ") + (r.action == "" ? "Closure" : r.action);
                self.output.twoColumn(left, "<fg=gray>" + right + "</>");
            }
            self.newLine();
            self.output.writeln(Text.padLeft("Showing [${rows.size()}] routes", 60));
            return 0;
        }
    }

    class ServeCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "serve {--host= : The address to listen on} {--port= : The port}"; }
        fn description() -> string { return "Serve the app over HTTP"; }
        fn handle(app: Application) -> int {
            let host = self.option("host") != "" ? self.option("host") : Config.getString("http.host", "*");
            let port = self.option("port") != "" ? self.optionInt("port") as int : Config.getInt("http.port", 8000) as int;
            self.output.infoBlock("Server running on [http://" + (host == "*" ? "127.0.0.1" : host) + ":${port}]. Press Ctrl+C to stop.");
            app.http().serve(port, host);
            return 0;
        }
    }

    class DownCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "down {--secret= : A path that lets you in (/secret)} {--with-secret : Make up a secret} {--retry=60 : Retry-After seconds} {--refresh=0 : Refresh the page after seconds} {--status=503} {--message=} {--allow=* : IPs that still get in}"; }
        fn description() -> string { return "Put the app into maintenance mode"; }
        fn handle(app: Application) -> int {
            let secret = self.flag("with-secret") ? Text.random(24) : self.option("secret");
            MaintenanceMode.down(app, secret, self.optionInt("retry", 60), self.optionInt("refresh", 0), self.optionInt("status", 503) as int, self.option("message"), self.optionList("allow"));
            self.output.infoBlock("Application is now in maintenance mode.");
            if (secret != "") { self.output.writeln("  You may bypass it at: " + app.url + "/" + secret); }
            return 0;
        }
    }

    class UpCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "up"; }
        fn description() -> string { return "Bring the app out of maintenance mode"; }
        fn handle(app: Application) -> int {
            if (!MaintenanceMode.up(app)) { self.output.infoBlock("Application is already up."); return 0; }
            self.output.infoBlock("Application is now live.");
            return 0;
        }
    }

    // ── migrations ─────────────────────────────────────────────────────────────
    class MigrateCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "migrate {--force : Run in production without asking} {--seed : Seed afterwards}"; }
        fn description() -> string { return "Run the migrations not run yet"; }
        fn handle(app: Application, m: Migrator) -> int {
            if (!FrameworkCommands.confirmInProduction(self, app)) { return 1; }
            let ran = m.migrate();
            if (ran.size() == 0) { self.output.infoBlock("Nothing to migrate."); }
            else { self.output.infoBlock("Running migrations."); for (n in ran) { self.output.twoColumn(n, "<fg=green;options=bold>DONE</>"); } self.newLine(); }
            if (self.flag("seed")) { return self.call("db:seed --force"); }
            return 0;
        }
    }
    class MigrateStatusCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "migrate:status"; }
        fn description() -> string { return "Show which migrations have run"; }
        fn handle(m: Migrator) -> int {
            for (line in m.status()) {
                let name = Text.before(line, ": ");
                let state = Text.after(line, ": ");
                self.output.twoColumn(name, Str.startsWith(state, "ran") ? "<fg=green>" + state + "</>" : "<fg=yellow>" + state + "</>");
            }
            return 0;
        }
    }
    class MigrateRollbackCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "migrate:rollback {--step=1 : How many batches} {--force}"; }
        fn description() -> string { return "Undo the last batch of migrations"; }
        fn handle(app: Application, m: Migrator) -> int {
            if (!FrameworkCommands.confirmInProduction(self, app)) { return 1; }
            let undone = m.rollback(self.optionInt("step", 1) as int);
            if (undone.size() == 0) { self.output.infoBlock("Nothing to rollback."); }
            for (n in undone) { self.output.twoColumn(n, "<fg=yellow;options=bold>ROLLED BACK</>"); }
            return 0;
        }
    }
    class MigrateResetCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "migrate:reset {--force}"; }
        fn description() -> string { return "Undo every migration"; }
        fn handle(app: Application, m: Migrator) -> int {
            if (!FrameworkCommands.confirmInProduction(self, app)) { return 1; }
            for (n in m.reset()) { self.output.twoColumn(n, "<fg=yellow;options=bold>ROLLED BACK</>"); }
            return 0;
        }
    }
    class MigrateRefreshCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "migrate:refresh {--seed} {--force}"; }
        fn description() -> string { return "Undo every migration, then run them all"; }
        fn handle(app: Application, m: Migrator) -> int {
            if (!FrameworkCommands.confirmInProduction(self, app)) { return 1; }
            let ran = m.refresh();
            self.output.infoBlock("Refreshed ${ran.size()} migration(s).");
            return self.flag("seed") ? self.call("db:seed --force") : 0;
        }
    }
    class MigrateFreshCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "migrate:fresh {--seed} {--force}"; }
        fn description() -> string { return "Drop every migrated table and migrate again"; }
        fn handle(app: Application, m: Migrator) -> int {
            if (!FrameworkCommands.confirmInProduction(self, app)) { return 1; }
            m.reset();
            let ran = m.migrate();
            self.output.infoBlock("Fresh: ${ran.size()} migration(s).");
            return self.flag("seed") ? self.call("db:seed --force") : 0;
        }
    }
    class DbSeedCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "db:seed {--class=DatabaseSeeder : The seeder} {--force}"; }
        fn description() -> string { return "Seed the database"; }
        fn handle(app: Application) -> int {
            if (!FrameworkCommands.confirmInProduction(self, app)) { return 1; }
            let name = self.option("class");
            let s = app.seeders.getOr(name, null);
            if (s == null) { self.error("No seeder called '" + name + "' (give it to withSeeders)."); return 1; }
            let ok = self.task("Seeding " + name, fn() -> bool { Seeder.seed(s); return true; });
            return ok ? 0 : 1;
        }
    }

    // ── queues ─────────────────────────────────────────────────────────────────
    class QueueWorkCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string {
            return "queue:work {connection? : The queue connection} {--queue=default : Queues, highest priority first (high,default)} {--name=default} " +
                   "{--tries=1} {--timeout=60} {--sleep=3} {--backoff=0 : Seconds (or a list: 10,60)} {--max-jobs=0} {--max-time=0} {--memory=128} " +
                   "{--rest=0 : Milliseconds between jobs} {--threads=1 : Workers in this process} {--stop-when-empty} {--once : One job, then stop}";
        }
        fn description() -> string { return "Process jobs on the queue"; }
        fn handle(q: QueueManager) -> int {
            let o = new WorkerOptions();
            o.name = self.option("name");
            o.tries = self.optionInt("tries", 1) as int;
            o.timeout = self.optionInt("timeout", 60) as int;
            o.sleep = self.optionFloat("sleep", 3.0);
            let backoff = new Array<int>();
            for (b in Str.split(self.option("backoff"), ",")) { backoff.push(Integer.parseOr(Str.trim(b), 0) as int); }
            o.backoff = backoff;
            o.maxJobs = self.flag("once") ? 1 : self.optionInt("max-jobs", 0) as int;
            o.maxTime = self.optionInt("max-time", 0);
            o.memoryMb = self.optionInt("memory", 128);
            o.restMs = self.optionInt("rest", 0);
            o.stopWhenEmpty = self.flag("stop-when-empty") || self.flag("once");
            o.trapSignals = true;
            o.retryAfter = Config.getInt("queue.retry_after", 90);
            let out = self.output;
            o.output = fn(line: string) { out.writeln("  " + line); };
            let conn = self.argument("connection") == "" ? q.defaultConnection : self.argument("connection");
            let queues = new Array<string>();
            for (x in Str.split(self.option("queue"), ",")) { queues.push(Str.trim(x)); }
            self.output.infoBlock("Processing jobs from the [" + Str.join(queues, ",") + "] queue" + (queues.size() > 1 ? "s" : "") + " on [" + conn + "].");
            let threads = self.optionInt("threads", 1) as int;
            return threads > 1 ? q.worker().workConcurrently(threads, conn, queues, o) : q.worker().work(conn, queues, o);
        }
    }
    class QueueFailedCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "queue:failed"; }
        fn description() -> string { return "List the failed jobs"; }
        fn handle(q: QueueManager) -> int {
            let all = q.failedJobs.all();
            if (all.size() == 0) { self.output.infoBlock("No failed jobs found."); return 0; }
            for (f in all) {
                self.output.twoColumn("<fg=gray>" + f.failedMoment().toDateTimeString() + "</> " + f.id, f.connection + "@" + f.queue + " " + f.jobClass());
            }
            return 0;
        }
    }
    class QueueRetryCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "queue:retry {id?* : Failed job ids} {--all : Every failed job}"; }
        fn description() -> string { return "Put failed jobs back on their queues"; }
        fn handle(q: QueueManager) -> int {
            if (self.flag("all") || (self.argumentList("id").size() == 1 && self.argumentList("id")[0] == "all")) {
                let n = q.retryAll();
                self.output.infoBlock("Pushed ${n} failed job(s) back onto the queue.");
                return 0;
            }
            let ids = self.argumentList("id");
            if (ids.size() == 0) { self.error("Give the failed job ids (or --all)."); return 1; }
            for (id in ids) {
                if (q.retry(id)) { self.output.twoColumn(id, "<fg=green;options=bold>DONE</>"); } else { self.error("Unable to find failed job " + id + "."); }
            }
            return 0;
        }
    }
    class QueueForgetCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "queue:forget {id}"; }
        fn description() -> string { return "Delete a failed job"; }
        fn handle(q: QueueManager) -> int {
            if (!q.failedJobs.forget(self.argument("id"))) { self.error("No failed job matches the given ID."); return 1; }
            self.output.infoBlock("Failed job deleted successfully.");
            return 0;
        }
    }
    class QueueFlushCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "queue:flush {--hours=0 : Only those older than this}"; }
        fn description() -> string { return "Delete the failed jobs"; }
        fn handle(q: QueueManager) -> int {
            let n = q.failedJobs.flush(self.optionInt("hours", 0));
            self.output.infoBlock("Deleted ${n} failed job(s).");
            return 0;
        }
    }
    class QueueRestartCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "queue:restart"; }
        fn description() -> string { return "Tell every worker to stop after its current job"; }
        fn handle(q: QueueManager) -> int { Worker.signalRestart(q.cache); self.output.infoBlock("Broadcasting queue restart signal."); return 0; }
    }
    class QueueClearCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "queue:clear {connection?} {--queue=default} {--force}"; }
        fn description() -> string { return "Delete every job on a queue"; }
        fn handle(app: Application, q: QueueManager) -> int {
            if (!FrameworkCommands.confirmInProduction(self, app)) { return 1; }
            let conn = self.argument("connection") == "" ? q.defaultConnection : self.argument("connection");
            let n = q.clear(self.option("queue"), conn);
            self.output.infoBlock("Cleared ${n} job(s) from the [" + self.option("queue") + "] queue.");
            return 0;
        }
    }
    class QueueMonitorCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "queue:monitor {queues : connection:queue,… (or just queue names)} {--max=1000 : Fire QueueBusy above this}"; }
        fn description() -> string { return "Show how many jobs wait on queues (and say when there are too many)"; }
        fn handle(q: QueueManager) -> int {
            let max = self.optionInt("max", 1000);
            for (spec in Str.split(self.argument("queues"), ",")) {
                let s = Str.trim(spec);
                let conn = Str.contains(s, ":") ? Text.before(s, ":") : q.defaultConnection;
                let name = Str.contains(s, ":") ? Text.after(s, ":") : s;
                let size = q.size(name, conn);
                let status = size > max ? "<fg=red;options=bold>ALERT</>" : "<fg=green;options=bold>OK</>";
                self.output.twoColumn("[" + conn + "] " + name, "[${size}] " + status);
                if (size > max) { q.fire(new QueueBusy(conn, name, size)); }
            }
            return 0;
        }
    }

    class CacheClearCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "cache:clear"; }
        fn description() -> string { return "Flush the app cache"; }
        fn handle(cache: CacheRepository) -> int { cache.flush(); self.output.infoBlock("Application cache cleared successfully."); return 0; }
    }
    class ViewClearCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "view:clear"; }
        fn description() -> string { return "Forget every parsed template"; }
        fn handle(views: ViewFactory) -> int { views.flush(); self.output.infoBlock("Compiled views cleared successfully."); return 0; }
    }
    class MailTestCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "mail:test {to : Where to send it} {--mailer= : Which mailer}"; }
        fn description() -> string { return "Send a test mail"; }
        fn handle(app: Application, mail: MailManager) -> int {
            let m = mail.mailer(self.option("mailer"));
            let sent = m.raw(self.argument("to"), "Test mail from " + app.name, "If you can read this, " + app.name + " can send mail through the [" + m.name + "] mailer.");
            self.output.infoBlock("Sent through [" + m.name + "]: " + sent.id);
            return 0;
        }
    }
    class InspireCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string { return "inspire"; }
        fn description() -> string { return "Display an inspiring quote"; }
        fn handle() -> int {
            let quotes: Array<string> = ["Simplicity is the ultimate sophistication. — Leonardo da Vinci",
                "Well begun is half done. — Aristotle", "Very little is needed to make a happy life. — Marcus Aurelius",
                "It is quality rather than quantity that matters. — Seneca", "Order your soul. Reduce your wants. — Augustine",
                "The best way to take care of the future is to take care of the present moment. — Thich Nhat Hanh",
                "An unexamined life is not worth living. — Socrates", "Waste no more time arguing what a good man should be, be one. — Marcus Aurelius"];
            self.output.writeln("\n  <fg=gray>“</> " + quotes[Random.nextInt(0, quotes.size() - 1)] + "\n");
            return 0;
        }
    }
}
