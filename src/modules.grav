// modules.grav — the providers of the modules added in 0.3: encryption,
// storage disks, translations, broadcasting (and the sockets server), feature
// flags, search, the Telescope, Pulse and queue dashboards, and social
// sign-in; each made from the configuration (defaults.grav).
import "std"
import "apogee-container"
import "apogee-config"
import "apogee-events"
import "apogee-http"
import "apogee-routing"
import "apogee-auth"
import "apogee-queue"
import "apogee-console"
import "apogee-crypt"
import "apogee-storage"
import "apogee-lang"
import "apogee-sockets"
import "apogee-broadcast"
import "apogee-queue-dashboard"
import "apogee-pennant"
import "apogee-scout"
import "apogee-telescope"
import "apogee-pulse"
import "apogee-socialite"
import "grav-cache"
import "grav-redis"
import "grav-db"
import "application.grav"

namespace apogee {

    class ModuleProviders {
        static fn all() -> Array<ServiceProvider> {
            return [new CryptServiceProvider() as ServiceProvider, new StorageServiceProvider(), new LangServiceProvider(),
                    new BroadcastServiceProvider(), new FeatureServiceProvider(), new ScoutServiceProvider(),
                    new TelescopeServiceProvider(), new PulseServiceProvider(), new QueueDashboardServiceProvider(),
                    new SocialiteServiceProvider()];
        }
        // Who may open a dashboard: locally anyone on this machine; elsewhere a
        // signed-in user the gate allows `ability` ("viewTelescope"…; define it).
        static fn gate(app: Application, ability: string) -> fn(Request) -> bool {
            let c = app.container;
            return fn(req: Request) -> bool {
                if (app.isLocal()) { return Telescope.local(req); }
                let g = c.make::<Gate>();
                return req.user != null && g.has(ability) && g.allows(req.user, ability);
            };
        }
        // The app key when it is long enough to sign and encrypt with, else "".
        static fn usableKey(app: Application) -> string {
            try {
                new CryptKeys(app.key)
                return app.key
            } catch (x: ValueError) { return ""; }
        }
        // A dashboard's routes: with the session (so the gate knows who is
        // signed in) and only same-origin requests changing anything.
        static fn dashboardRoutes(r: Router, add: fn(Router)) {
            r.aliasInstance("same-origin", new SameOriginOnly());
            r.middleware(["session", "same-origin"]).group(fn(g: Router) { add(g); });
        }
        // The pool a module's tables are written through. On SQLite, Orbit's own
        // connection (this thread's): a second connection would wait on the
        // write lock of any transaction this thread has open (a seeder, a
        // request's DB.transaction), so the module's writes join it instead.
        // On MySQL and PostgreSQL, the app's pool.
        static fn storePool(app: Application) -> Pool {
            let driver = Config.getString("database.connections." + Config.getString("database.default", "sqlite") + ".driver", Config.getString("database.default", "sqlite"));
            return driver == "sqlite" ? new OrbitConnectionPool() as Pool : app.container.make::<Pool>();
        }
        static fn splitList(s: string) -> Array<string> {
            let out = new Array<string>();
            for (x in Str.split(s, ",")) { if (Str.trim(x) != "") { out.push(Str.trim(x)); } }
            return out;
        }
    }

    // Crypt with the app key (and app.previous_keys, comma-separated, to read what older keys sealed).
    class CryptServiceProvider extends ServiceProvider {
        constructor() {}
        fn register() {
            let app = self.app;
            // (a key too short to encrypt with: the app still starts, and Crypt says why when first used)
            try {
                let e = new Encrypter(app.key, ModuleProviders.splitList(Config.getString("app.previous_keys")));
                Crypt.use(e);
                app.container.instance::<Encrypter>(e);
            } catch (x: ValueError) {}
            app.container.singleton::<MessageSigner>(fn(c: Container) -> MessageSigner { return new MessageSigner(app.key); });
        }
    }

    // filesystems.*: the local and public disks, s3 when a bucket is set; filesystems.default first.
    class StorageServiceProvider extends ServiceProvider {
        constructor() {}
        fn register() {
            let app = self.app;
            let disks = new HashMap<string, Disk>();
            let key = ModuleProviders.usableKey(app);
            disks.put("local", new LocalDisk(Config.getString("filesystems.disks.local.root"), "", key));
            disks.put("public", new LocalDisk(Config.getString("filesystems.disks.public.root"), Config.getString("filesystems.disks.public.url"), key));
            let bucket = Config.getString("filesystems.disks.s3.bucket");
            if (bucket != "") {
                let b = "filesystems.disks.s3.";
                let endpoint = Config.getString(b + "endpoint");
                let cfg = endpoint == ""
                    ? S3Config.aws(bucket, Config.getString(b + "region"), Config.getString(b + "key"), Config.getString(b + "secret"))
                    : new S3Config(bucket, Config.getString(b + "region"), Config.getString(b + "key"), Config.getString(b + "secret"), endpoint, Config.getBool(b + "path_style", true));
                disks.put("s3", new S3Disk(cfg));
            }
            // (the default disk is the first added)
            let def = Config.getString("filesystems.default", "local");
            if (disks.containsKey(def)) { Storage.addDisk(def, disks.get(def)); }
            for ((name, d) in disks) { if (name != def) { Storage.addDisk(name, d); } }
        }
    }

    // A translator over lang/ (app.locale, app.fallback_locale).
    class LangServiceProvider extends ServiceProvider {
        constructor() {}
        fn register() {
            let t = new Translator(Config.getString("lang.path"), Config.getString("app.locale", "en"), Config.getString("app.fallback_locale", "en"));
            Lang.use(t);
            self.app.container.instance::<Translator>(t);
        }
    }

    // broadcasting.default: null, log or sockets (the sockets:serve server, or any Pusher-protocol one).
    class BroadcastServiceProvider extends ServiceProvider {
        constructor() {}
        fn register() {
            let s = "broadcasting.connections.sockets.";
            let driver = Config.getString("broadcasting.default", "null");
            if (driver == "sockets") {
                Broadcast.use(new SocketsBroadcaster(Config.getString(s + "url"), Config.getString(s + "app_id"), Config.getString(s + "key"), Config.getString(s + "secret")));
            } else if (driver == "log") {
                let log = self.app.container.make::<LogChannel>();
                Broadcast.use(new LogBroadcaster(fn(line: string) { log.info(line); }));
            } else {
                Broadcast.use(new NullBroadcaster());
            }
            Broadcast.credentials(Config.getString(s + "key"), Config.getString(s + "secret"));
        }
        // Dispatching a BroadcastEvent broadcasts it; private and presence channels sign in at /broadcasting/auth.
        fn boot() {
            let c = self.app.container;
            Broadcast.listenTo(c.make::<Events>());
            if (Config.getString("broadcasting.default", "null") != "null") {
                c.make::<Router>().middleware(["web"]).group(fn(g: Router) {
                    g.post("/broadcasting/auth", fn(req: Request) -> Response { return Broadcast.auth(req); });
                });
            }
        }
    }

    // features.store: memory, database or cache.
    class FeatureServiceProvider extends ServiceProvider {
        constructor() {}
        fn boot() {
            let c = self.app.container;
            let store = Config.getString("features.store", "database");
            if (store == "database") {
                let s = new DatabaseFeatureStore(ModuleProviders.storePool(self.app))
                s.createTable()
                Feature.useStore(s)
            }
            else if (store == "cache") { Feature.useStore(new CacheFeatureStore(c.make::<CacheRepository>().store)); }
            else { Feature.useStore(new MemoryFeatureStore()); }
            c.make::<Router>().aliasMiddleware("feature", fn(a: Array<string>) -> Middleware { return new EnsureFeature(Str.join(a, ",")); });
        }
    }

    // scout.driver: memory, database (full-text search in the app's database) or meilisearch.
    class ScoutServiceProvider extends ServiceProvider {
        constructor() {}
        fn boot() {
            let driver = Config.getString("scout.driver", "database");
            Scout.prefix = Config.getString("scout.prefix");
            if (driver == "database") {
                let e = new DatabaseEngine(ModuleProviders.storePool(self.app))
                e.createTables()
                Scout.use(e)
            }
            else if (driver == "meilisearch") { Scout.use(new MeilisearchEngine(Config.getString("scout.meilisearch.host"), Config.getString("scout.meilisearch.key"))); }
            else { Scout.use(new MemoryEngine()); }
        }
    }

    // telescope.enabled (by default only when local): every request and what it did, at /telescope.
    class TelescopeServiceProvider extends ServiceProvider {
        constructor() {}
        fn boot() {
            let app = self.app;
            let c = app.container;
            if (!Config.getBool("telescope.enabled", false)) {
                Telescope.recording = false
                return
            }
            if (Config.getString("telescope.driver", "database") == "database") {
                let s = new DatabaseTelescopeStore(ModuleProviders.storePool(app));
                s.createTable();
                Telescope.use(s);
            } else {
                Telescope.use(new MemoryTelescopeStore());
            }
            Telescope.recording = true;
            Telescope.slowQueryMs = Config.getInt("telescope.slow_query_ms", 100) as float;
            Telescope.ignorePaths = ModuleProviders.splitList(Config.getString("telescope.ignore_paths"));
            Telescope.watchQueries();
            Telescope.watchModels();
            Telescope.watchExceptions(c.make::<HttpKernel>());
            Telescope.watchJobs(c.make::<Events>());
            c.make::<LogChannel>().addHandler(new TelescopeLogHandler());
            Telescope.setGate(ModuleProviders.gate(app, "viewTelescope"));
            let r = c.make::<Router>();
            r.aliasInstance("telescope", new TelescopeMiddleware());
            r.use("telescope");
            ModuleProviders.dashboardRoutes(r, fn(g: Router) { Telescope.routes(g, Config.getString("telescope.path", "telescope")); });
        }
    }

    // pulse.enabled: per-minute production metrics, at /pulse.
    class PulseServiceProvider extends ServiceProvider {
        constructor() {}
        fn boot() {
            let app = self.app;
            let c = app.container;
            if (!Config.getBool("pulse.enabled", false)) {
                Pulse.recording = false
                return
            }
            if (Config.getString("pulse.driver", "database") == "database") {
                // (its own pool: it writes from a background thread, and retries a flush that meets a lock)
                let s = new DatabasePulseStore(c.make::<Pool>());
                s.createTables();
                Pulse.use(s);
            } else {
                Pulse.use(new MemoryPulseStore());
            }
            Pulse.recording = true;
            Pulse.slowRequestMs = Config.getInt("pulse.slow_request_ms", 1000) as double;
            Pulse.slowQueryMs = Config.getInt("pulse.slow_query_ms", 1000) as double;
            Pulse.slowJobMs = Config.getInt("pulse.slow_job_ms", 1000) as double;
            Pulse.sampleRate = Float.parseOr(Config.getString("pulse.sample_rate", "1"), 1.0);
            Pulse.keepHours = Config.getInt("pulse.keep_hours", 168) as int;
            Pulse.ignorePaths = ModuleProviders.splitList(Config.getString("pulse.ignore_paths"));
            let server = Config.getString("pulse.server");
            if (server != "") { Pulse.server = server; }
            Pulse.watchQueries();
            Pulse.watchExceptions(c.make::<HttpKernel>());
            Pulse.watchJobs(c.make::<Events>());
            Pulse.setGate(ModuleProviders.gate(app, "viewPulse"));
            let r = c.make::<Router>();
            r.aliasInstance("pulse", new PulseMiddleware());
            r.use("pulse");
            ModuleProviders.dashboardRoutes(r, fn(g: Router) { Pulse.routes(g, Config.getString("pulse.path", "pulse")); });
            Pulse.start();
        }
    }

    // queue_dashboard.enabled: the queue's jobs, waits, failures and batches, at /queue-dashboard.
    class QueueDashboardServiceProvider extends ServiceProvider {
        constructor() {}
        fn boot() {
            let app = self.app;
            let c = app.container;
            if (!Config.getBool("queue_dashboard.enabled", false)) { return; }
            let driver = Config.getString("queue_dashboard.driver", "database");
            let store: DashboardStore = null;
            if (driver == "redis") { store = new RedisDashboardStore(RedisConnection.open(Config.getString("redis.url"))); }
            else if (driver == "database") {
                let s = new DatabaseDashboardStore(ModuleProviders.storePool(app))
                s.createTables()
                store = s
            }
            else { store = new MemoryDashboardStore(); }
            let dash = new QueueDashboard(c.make::<QueueManager>(), store);
            c.instance::<QueueDashboard>(dash);
            dash.attach(c.make::<Events>());
            dash.gate(ModuleProviders.gate(app, "viewQueueDashboard"));
            ModuleProviders.dashboardRoutes(c.make::<Router>(), fn(g: Router) { dash.routes(g, Config.getString("queue_dashboard.path", "queue-dashboard")); });
        }
    }

    // services.<provider>.client_id / client_secret / redirect: each one with a client id is configured.
    class SocialiteServiceProvider extends ServiceProvider {
        constructor() {}
        fn register() {
            for (name in ["github", "google", "microsoft", "gitlab", "bitbucket", "discord", "facebook", "linkedin", "slack", "oidc"]) {
                let b = "services." + name + ".";
                let id = Config.getString(b + "client_id");
                if (id == "") { continue; }
                let extra = new HashMap<string, string>();
                for (k in ["tenant", "host", "issuer", "scopes"]) {
                    let v = Config.getString(b + k)
                    if (v != "") { extra.put(k, v); }
                }
                Socialite.configure(name, id, Config.getString(b + "client_secret"), Config.getString(b + "redirect"), extra);
            }
        }
    }

    // Refuses a request that changes something (not GET, HEAD or OPTIONS) when
    // its Origin, or else its Referer, names another site: a browser sends one
    // of them with every cross-site POST, so no other page can press a
    // dashboard's buttons for a signed-in admin. (Without either it is not a
    // browser, so not a forgery.)
    class SameOriginOnly implements Middleware {
        constructor() {}
        fn handle(req: Request, next: fn(Request) -> Response) -> Response {
            let m = req.method();
            if (m == "GET" || m == "HEAD" || m == "OPTIONS") { return next(req); }
            let from = req.header("Origin");
            if (from == "" || from == "null") { from = req.header("Referer"); }
            if (from != "" && SameOriginOnly.hostOf(from) != Str.lower(req.httpHost())) {
                return Response.json({"message": "Cross-site request refused."}, 403);
            }
            return next(req);
        }
        // "https://Example.com:8443/x" -> "example.com:8443"
        static fn hostOf(url: string) -> string {
            let s = url;
            let scheme = Str.indexOf(s, "://");
            if (scheme >= 0) { s = s[scheme + 3..]; }
            let slash = Str.indexOf(s, "/");
            if (slash >= 0) { s = s[..slash]; }
            return Str.lower(s);
        }
    }

    // ── commands ───────────────────────────────────────────────────────────────
    class SocketsServeCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string {
            return "sockets:serve {--host= : The address to listen on} {--port= : The port}";
        }
        fn description() -> string {
            return "Serve WebSockets (the Pusher protocol) for broadcasting";
        }
        fn handle(app: Application) -> int {
            let s = "broadcasting.connections.sockets.";
            let host = self.option("host") != "" ? self.option("host") : Config.getString("sockets.host", "0.0.0.0");
            let port = self.option("port") != "" ? self.optionInt("port") as int : Config.getInt("sockets.port", 6001) as int;
            let apps: Array<SocketsApp> = [new SocketsApp(Config.getString(s + "app_id"), Config.getString(s + "key"), Config.getString(s + "secret"))];
            self.output.infoBlock("Sockets running on [ws://" + (host == "0.0.0.0" ? "127.0.0.1" : host) + ":${port}]. Press Ctrl+C to stop.");
            new SocketsServer(new SocketsConfig(apps)).serve(host, port);
            return 0;
        }
    }

    class TelescopePruneCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string {
            return "telescope:prune {--hours=24 : Keep entries this recent}";
        }
        fn description() -> string {
            return "Remove old Telescope entries";
        }
        fn handle(app: Application) -> int {
            let hours = self.option("hours") != "" ? self.optionInt("hours") : 24 as long;
            self.output.writeln("<info>Removed ${Telescope.store.prune(hours)} entries.</>");
            return 0;
        }
    }

    class TelescopeClearCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string {
            return "telescope:clear";
        }
        fn description() -> string {
            return "Remove every Telescope entry";
        }
        fn handle(app: Application) -> int {
            Telescope.store.clear()
            self.output.writeln("<info>Telescope entries cleared.</>")
            return 0
        }
    }

    class PulseClearCommand extends ConsoleCommand {
        constructor() {}
        fn signature() -> string {
            return "pulse:clear";
        }
        fn description() -> string {
            return "Remove every Pulse metric";
        }
        fn handle(app: Application) -> int {
            Pulse.store.clear()
            self.output.writeln("<info>Pulse metrics cleared.</>")
            return 0
        }
    }

    class ModuleCommands {
        static fn register(k: ConsoleKernel) {
            k.add::<SocketsServeCommand>(); k.add::<TelescopePruneCommand>(); k.add::<TelescopeClearCommand>(); k.add::<PulseClearCommand>();
        }
    }
}
